#!/usr/bin/env bash
# 提交时若 bump 了 csproj 的 <Version>,自动打 vX.Y.Z tag。
# 配合 git config push.followTags true,git push 会把 tag 一起推上,
# 从而触发 .github/workflows/release.yml 自动出 Release。
set -euo pipefail

csproj="src/BatteryTray/BatteryTray.csproj"
[[ -f "$csproj" ]] || exit 0

version="$(grep -oPm1 '(?<=<Version>)[^<]+' "$csproj" || true)"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || exit 0
tag="v$version"

# 只有本次提交确实改了版本文件才动手(普通提交不打扰)
if git diff-tree --no-commit-id --name-only -r HEAD | grep -qx "$csproj"; then
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    if [[ "$(git rev-parse "$tag")" != "$(git rev-parse HEAD)" ]]; then
      echo "⚠  $tag 已存在但指向别的提交( amend/变基过?)。" >&2
      echo "   如需重打: git tag -d $tag && git tag -a $tag" >&2
    fi
  else
    git tag -a "$tag" -m "v$version"
    echo "✓ 已自动打 tag $tag;git push 时会随 push.followTags 一起推送并触发 Release" >&2
  fi
fi
exit 0
